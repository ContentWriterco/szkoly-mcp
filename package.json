{
  "name": "szkoly-mcp",
  "version": "0.1.1",
  "description": "MCP server: schools in Poland for AI agents – official register of schools and kindergartens (SIO) with per-school eighth-grade exam and matura results (CKE) vs county and national averages. No API key.",
  "type": "module",
  "bin": {
    "szkoly-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "test": "npm run build && node --test test/unit.test.mjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "szkoly",
    "przedszkola",
    "egzamin-osmoklasisty",
    "matura",
    "rspo",
    "cke",
    "wybor-szkoly",
    "schools",
    "education",
    "poland",
    "open-data",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContentWriterco/szkoly-mcp.git"
  },
  "homepage": "https://szkoly.compabase.com",
  "bugs": {
    "url": "https://github.com/ContentWriterco/szkoly-mcp/issues"
  },
  "mcpName": "io.github.ContentWriterco/szkoly-mcp"
}
